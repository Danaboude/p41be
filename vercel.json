{
  "version": 2,
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist/p41.be/browser",
  "routes": [
    {
      "src": "/(.*)",
      "headers": {
        "X-Content-Type-Options": "nosniff",
        "X-Frame-Options": "SAMEORIGIN",
        "Referrer-Policy": "strict-origin-when-cross-origin",
        "Permissions-Policy": "camera=(), microphone=(), geolocation=(), payment=()",
        "Strict-Transport-Security": "max-age=63072000; includeSubDomains"
      },
      "continue": true
    },
    {
      "src": "/(main|chunk|polyfills|styles)-[A-Za-z0-9]+\\.(js|css)",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      },
      "continue": true
    },
    {
      "src": "/(admin|admin/.*|academy/access/.*|api/.*|404|404\\.html)",
      "headers": {
        "X-Robots-Tag": "noindex, nofollow"
      },
      "continue": true
    },
    {
      "src": "/sitemap\\.xml",
      "dest": "/api/sitemap"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/admin(/.*)?",
      "dest": "/index.csr.html"
    },
    {
      "src": "/academy/access/.+",
      "dest": "/index.csr.html"
    },
    {
      "src": "/blog/[^/]+/?",
      "dest": "/index.csr.html"
    },
    {
      "src": "/academy/[^/]+/?",
      "dest": "/index.csr.html"
    },
    {
      "src": "/.*",
      "status": 404,
      "dest": "/404.html"
    }
  ]
}
